{
  "name": "Referans Ters Panel — koyu zeminde yapışkan anlatı + logo karoları",
  "description": "Koyu zemin: solda yapışkan başlık, metin ve isteğe bağlı düğme; sağda 2 sütun çizgili karolarda logolar, üzerine gelince karo içten vurgu ışığı alır. Koyu, premium sunum: referanslar anlatı + çağrı ile birlikte (kenar düzeni), karolar ışık sınırıyla parlar. Metinler dil sözlüğü, renkler desing + var(--mx-site-*), mantıksal CSS → RTL. Veri yoksa blok basılmaz.",
  "version": "1.0.0",
  "icon": "contrast",
  "category": "referans",
  "subCategory": "dark-split",
  "tags": [
    "referans",
    "dark",
    "split",
    "sticky",
    "logos",
    "rtl",
    "fabrika"
  ],
